<?xml version="1.0" encoding="UTF-8"?>
<!--
    Logback configuration for the barrier CLI.

    The default is a compact one-line format on stderr so the JSON / pretty
    stdout stream stays parseable. Set the JVM property `-Dbarrier.log.level=DEBUG`
    (or use `barrier -v`) to bump the level.
-->
<configuration>
    <property name="LOG_LEVEL" value="${barrier.log.level:-INFO}"/>

    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{20} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="${LOG_LEVEL}">
        <appender-ref ref="STDERR"/>
    </root>
</configuration>
